# FXOS Environment Variables Template
# Copy this file to .env and modify the values as needed

# ===========================================
# Server Configuration
# ===========================================

# Backend API server port (localhost-only by default, 127.0.0.1 binding)
FXOS_BACKEND_PORT=8080

# Frontend web interface port — HTTPS ONLY (MANDATORY)
# Host ${FXOS_FRONTEND_PORT} → Container 443 (TLS terminated inside nginx)
# Even if you type http://<IP>:3000 in the browser, the server will detect the
# plaintext request on the TLS listener (nginx error 497) and auto-redirect it
# to https:// on the same port. There is no separate HTTP/HTTPS port split.
FXOS_FRONTEND_PORT=3000

# Timezone
FXOS_TIMEZONE=Asia/Shanghai

# ===========================================
# SSL / HTTPS Configuration (HTTPS is mandatory)
# ===========================================
# HTTPS is mandatory on the frontend port. By default a self-signed certificate
# with the auto-detected server IP as SANs is generated on first start.
# The self-signed cert triggers a ONE-TIME browser warning — click
# "Advanced → Continue" to proceed (see docs/guides/SSL-HTTPS.zh-CN.md).
#
# Even if set to false, the scripts will still ensure certs exist because
# the frontend docker port maps to TLS 443 internally. Keep "true" below
# unless you want container-only fallback certs (slightly weaker SANs).
FXOS_ENABLE_SSL=true

# Optional: use your own trusted CA certificate / key (e.g. Let's Encrypt, ZeroSSL)
# BOTH paths must be set and readable. The cert & private key will be modulus-
# checked before use to prevent nginx startup crashes.
# FXOS_SSL_CERT=/etc/letsencrypt/live/your-domain.com/fullchain.pem
# FXOS_SSL_KEY=/etc/letsencrypt/live/your-domain.com/privkey.pem

# Optional: explicitly set the server IP written into the self-signed cert
# Subject Alternative Names (SANs). Use this on multi-homed servers, VMs with
# NAT, or when auto-detection picks the wrong interface IP.
# FXOS_SERVER_IP=1.2.3.4

# ===========================================
# Authentication (Required)
# ===========================================

# JWT signing secret (any random string, at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-this-in-production

# ===========================================
# Encryption Keys (Required)
# ===========================================

# AES-256 data encryption key (Base64 encoded, 32 bytes)
# Used for encrypting sensitive data in database (API keys, secrets)
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# RSA private key for client-server encryption (PEM format)
# Used for end-to-end encryption of sensitive data from browser
# Generate with: openssl genrsa 2048
# Note: Replace newlines with \n for single-line format
RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----

# ===========================================
# Security Options
# ===========================================

# Transport encryption for API keys (default: false)
# When enabled, browser uses Web Crypto API to encrypt API keys before sending
# Requires HTTPS or localhost to work
# Set to true for enhanced security (HTTPS required)
# Set to false for easier deployment (HTTP/IP access allowed)
TRANSPORT_ENCRYPTION=false

# CORS allowed origins (comma-separated)
# Required when accessing the API from a different origin (e.g. remote browser)
# Examples:
#   CORS_ALLOWED_ORIGINS=http://your-server-ip:3000
#   CORS_ALLOWED_ORIGINS=http://your-domain.com,https://your-domain.com
# Default: localhost dev origins only (localhost:3000, localhost:5173)
# Use "*" to allow all origins (INSECURE, only for testing)
# CORS_ALLOWED_ORIGINS=http://your-server-ip:3000

# Vite dev server proxy target (dev mode only)
# Change this to your backend IP when developing remotely
# Example: FXOS_BACKEND_URL=http://your-server-ip:8080
# FXOS_BACKEND_URL=http://localhost:8080

# Frontend build-time API base URL (for direct backend access without Nginx proxy)
# Set this when the frontend is NOT behind Nginx and needs to call the backend directly
# Example: VITE_API_BASE_URL=http://your-server-ip:8080
# VITE_API_BASE_URL=

# ===========================================
# Optional: External Services
# ===========================================

# ===========================================
# Network Proxy (Optional)
# ===========================================
# Set a proxy when direct connection to exchanges is blocked.
# Supports: socks5://, socks://, http://, https://
# ALL_PROXY takes priority over per-scheme variables.
#
# ALL_PROXY=socks5://127.0.0.1:10808
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080

DB_TYPE=postgres
DB_HOST=10.
DB_PORT=5432
DB_USER=fxos_user
DB_PASSWORD=
DB_NAME=fxos
DB_SSLMODE=disable


# Database configuration - SQLite (default)
DB_TYPE=sqlite
DB_PATH=data/data.db