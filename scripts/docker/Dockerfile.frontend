# docker/frontend/Dockerfile

# ═══════════════════════════════════════════════════════════════
# FXOS Frontend Dockerfile (Node Build → Nginx Runtime)
# Versions extracted as ARGs for consistency
# Supports both HTTP (80) and HTTPS (443) with auto cert generation
# ═══════════════════════════════════════════════════════════════

ARG NODE_VERSION=20-alpine
ARG NGINX_VERSION=alpine

# ──────────────────────────────────────────────────────────────
# Build Stage (Node)
# ──────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION} AS builder
WORKDIR /build

COPY web/package*.json ./
RUN npm ci

COPY web/ ./
RUN npm run build

# ──────────────────────────────────────────────────────────────
# Runtime Stage (Nginx)
# ──────────────────────────────────────────────────────────────
FROM nginx:${NGINX_VERSION}

# Install openssl for on-the-fly self-signed cert generation
RUN apk add --no-cache openssl

COPY scripts/nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY scripts/nginx/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY --from=builder /build/dist /usr/share/nginx/html

RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/health || \
      wget --no-verbose --tries=1 --no-check-certificate --spider https://localhost/health || \
      exit 1

ENTRYPOINT ["docker-entrypoint.sh"]
